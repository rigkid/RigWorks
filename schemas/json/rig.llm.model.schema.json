{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.llm.model.schema.json",
  "title": "rig.llm.model",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "modelId": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "targetArch": {
      "type": "string",
      "enum": [
        "hailo10h",
        "cpu",
        "gpu",
        "vulkan",
        "cuda"
      ]
    },
    "contextTokens": {
      "type": "integer",
      "minimum": 1
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 1
    }
  },
  "minProperties": 1,
  "x-rig-maturity": "draft"
}
