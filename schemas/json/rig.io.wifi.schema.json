{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.io.wifi.schema.json",
  "title": "rig.io.wifi",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "off",
        "ap",
        "sta",
        "ap-sta"
      ]
    },
    "apSsid": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "staSsid": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "channel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    }
  },
  "x-rig-maturity": "draft"
}
