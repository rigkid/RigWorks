{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.finance.payment.schema.json",
  "title": "rig.finance.payment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "debtor": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "creditor": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "booked",
        "rejected",
        "cancelled"
      ]
    },
    "debtorAccount": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "creditorAccount": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "endToEndId": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "bookedDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO 8601 calendar date."
    },
    "invoice": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    }
  },
  "required": [
    "debtor",
    "creditor",
    "status"
  ],
  "description": "A movement of money. Field meanings follow ISO 20022 payment identification. Not a pacs message.",
  "x-rig-maturity": "draft"
}
