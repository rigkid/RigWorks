{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.vr.haptic.schema.json",
  "title": "rig.vr.haptic",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "amplitude": {
      "type": "number",
