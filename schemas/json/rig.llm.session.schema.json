{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.llm.session.schema.json",
  "title": "rig.llm.session",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "backendPreference": {
      "type": "string",
      "enum": [
        "auto",
        "hailo",
        "cpu",
        "gpu",
        "vulkan",
        "cuda"
      ]
    },
    "temperature": {
      "$ref": "./_defs.schema.json#/$defs/float"
    },
    "topP": {
      "$ref": "./_defs.schema.json#/$defs/float"
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 1
    },
    "contextTokens": {
      "type": "integer",
      "minimum": 1
    }
  },
  "x-rig-maturity": "draft"
}
