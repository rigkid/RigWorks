{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.geometry.polygon.schema.json",
  "title": "rig.geometry.polygon",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "points": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "./_defs.schema.json#/$defs/vec2"
      }
    },
    "closed": {
      "$ref": "./_defs.schema.json#/$defs/bool"
    },
    "fillRule": {
      "type": "string",
      "enum": [
        "nonzero",
        "evenodd"
      ]
    }
  },
  "required": [
    "points"
  ],
  "x-rig-maturity": "stable"
}
