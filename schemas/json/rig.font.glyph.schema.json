{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.font.glyph.schema.json",
  "title": "rig.font.glyph",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "unicodes": {
      "type": "array",
      "items": {
        "$ref": "./_defs.schema.json#/$defs/uint32"
