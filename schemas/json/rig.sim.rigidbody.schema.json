{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.sim.rigidbody.schema.json",
  "title": "rig.sim.rigidbody",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bodyType": {
      "type": "string",
      "enum": [
        "static",
        "dynamic",
        "kinematic"
      ]
    },
    "velocity": {
      "$ref": "./_defs.schema.json#/$defs/vec3"
    },
    "angularVelocityDegrees": {
      "$ref": "./_defs.schema.json#/$defs/vec3"
    },
    "mass": {
      "$ref": "./_defs.schema.json#/$defs/float"
    },
    "inertia": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number"
      },
      "$comment": "ixx, iyy, izz, ixy, ixz, iyz about centerOfMass, body frame"
    },
    "drag": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "angularDrag": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gravity": {
      "$ref": "./_defs.schema.json#/$defs/vec3"
    },
    "gravityScale": {
      "$ref": "./_defs.schema.json#/$defs/float"
    },
    "lockRotation": {
      "$ref": "./_defs.schema.json#/$defs/bool"
    },
    "canSleep": {
      "$ref": "./_defs.schema.json#/$defs/bool"
    },
    "continuous": {
      "$ref": "./_defs.schema.json#/$defs/bool"
    },
    "centerOfMass": {
      "$ref": "./_defs.schema.json#/$defs/vec3"
    }
  },
  "x-rig-maturity": "draft"
}
