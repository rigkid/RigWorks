{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.anim.track.schema.json",
  "title": "rig.anim.track",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clip": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "target": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "propertyKey": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "times": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "stride": {
      "type": "integer",
      "enum": [
        1,
        3,
        4
      ]
    }
  },
  "required": [
    "clip",
    "target",
    "propertyKey",
    "times",
    "values",
    "stride"
  ],
  "x-rig-maturity": "draft"
}
