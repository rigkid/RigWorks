{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.clinic.trial.schema.json",
  "title": "rig.clinic.trial",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identifier": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "status": {
      "type": "string",
      "enum": [
        "recruiting",
        "active",
        "completed",
        "withdrawn",
        "suspended"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "phase-1",
        "phase-2",
        "phase-3",
        "phase-4",
        "na"
      ]
    }
  },
  "required": [
    "identifier",
    "status"
  ],
  "description": "A clinical trial. Eligibility rows are rig.clinic.criterion entities."
}
