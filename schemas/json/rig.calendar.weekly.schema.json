{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.calendar.weekly.schema.json",
  "title": "rig.calendar.weekly",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "boolean"
      }
    },
    "startMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1439
    },
    "endMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1439
    }
  },
  "required": [
    "days",
    "startMinutes",
    "endMinutes"
  ],
  "x-rig-maturity": "draft"
}
