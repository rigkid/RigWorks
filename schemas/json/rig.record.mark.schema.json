{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.record.mark.schema.json",
  "title": "rig.record.mark",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "class": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "pii",
        "phi",
        "pci",
        "cui",
        "classified"
      ]
    },
    "marking": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "purpose": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "keep",
        "tombstone",
        "hold"
      ]
    },
    "retainYears": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "class"
  ],
  "description": "Classification and retention of a fact. Not copyright (rig.rights.statement) and not an ACL.",
  "x-rig-maturity": "draft"
}
