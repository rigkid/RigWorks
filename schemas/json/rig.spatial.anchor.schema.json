{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.spatial.anchor.schema.json",
  "title": "rig.spatial.anchor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "point": {
      "type": "string",
      "enum": [
        "topLeft",
        "topCenter",
        "topRight",
        "middleLeft",
        "center",
        "middleRight",
        "bottomLeft",
        "bottomCenter",
        "bottomRight"
      ]
    },
    "height": {
      "type": "string",
      "enum": [
        "min",
        "center",
        "max"
      ]
    }
  },
  "required": [
    "point"
  ]
}
