{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.bim.spec.schema.json",
  "title": "rig.bim.spec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ifcVersion": {
      "type": "string",
      "enum": [
        "ifc2x3",
        "ifc4",
