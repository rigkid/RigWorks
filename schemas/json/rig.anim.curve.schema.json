{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.anim.curve.schema.json",
  "title": "rig.anim.curve",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "./_defs.schema.json#/$defs/vec2"
      }
    },
    "interp": {
      "type": "string",
      "enum": [
        "linear",
        "smooth"
      ]
    },
    "preset": {
      "type": "string",
      "enum": [
        "linear",
        "easeIn",
        "easeOut",
        "easeInOut",
        "sCurve",
        "bulge",
        "squeeze",
        "custom"
      ]
    }
  },
  "required": [
    "points"
  ]
}
