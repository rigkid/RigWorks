{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.record.assertion.schema.json",
  "title": "rig.record.assertion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "./_defs.schema.json#/$defs/string"
    },
    "asserter": {
      "$ref": "./_defs.schema.json#/$defs/entity"
    },
    "observedDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO 8601 calendar date."
    },
    "observedMinute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1439
    },
    "observedSecond": {
      "type": "integer",
      "minimum": 0,
      "maximum": 59
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "source"
  ],
  "description": "Who stated a fact and when they observed it. Not document.author and not a query explain-plan.",
  "x-rig-maturity": "draft"
}
